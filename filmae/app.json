{
  "expo": {
    "name": "filmae",
    "slug": "filmae",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/filmae-mascote.png",
    "scheme": "filmae",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#B8070F",
        "foregroundImage": "./assets/images/filmae-mascote.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/filmae-mascote.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#B8070F",
          "image": "./assets/images/filmae-mascote.png",
          "imageWidth": 220
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "O Filmaê usa a câmera para você tirar a sua foto de perfil.",
          "photosPermission": "O Filmaê acessa suas fotos para você escolher a sua foto de perfil."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "O Filmaê usa o microfone para você gravar comentários em áudio sobre os filmes."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": false
    }
  }
}
